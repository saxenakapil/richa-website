---
// Shared page shell: <head>, share preview, menu, footer, toast and site script.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  minimal?: boolean; // no menu, footer or site script (404 page)
}

const {
  title,
  description = 'Small-town heart. Strict-teacher energy. Soft spot for every dog I meet.',
  minimal = false,
} = Astro.props;
const shareImage = new URL('/og.png', Astro.site);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Richa Saxena">
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={shareImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#000000">
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='28' fill='%23000'/><text x='50' y='68' font-size='56' text-anchor='middle' fill='%23B69CFF' font-family='Georgia'>R</text></svg>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Fraunces:opsz,wght,SOFT@9..144,400..800,50..100&display=swap" rel="stylesheet">
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  {!minimal && <div class="progress" aria-hidden="true"></div>}
  {!minimal && <Nav />}

  <slot />

  {!minimal && <Footer />}
  {!minimal && <div class="toast" id="toast" role="status" aria-live="polite"></div>}
  {!minimal && <div class="lumos-veil" aria-hidden="true"></div>}
  {!minimal && <script src="../scripts/site.js"></script>}
  <slot name="end" />
</body>
</html>
